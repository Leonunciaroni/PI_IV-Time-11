# Copie para infra/.env e ajuste os valores.

# Segredo HMAC usado para assinar e validar os JWTs (mínimo de 32 bytes).
# Gere um com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-pelo-menos-32-bytes

# MongoDB com autenticação (#54). Use só letras e números nas senhas, porque elas entram na URI.
# Gere cada valor com: openssl rand -hex 24
# Keyfile do replica set (os três nós se autenticam entre si com ele), de 6 a 1024 caracteres.
MONGO_KEYFILE=troque-este-keyfile-por-um-valor-aleatorio
# Usuário root, usado só pelo mongo-setup e para administrar o banco
MONGO_ROOT_USUARIO=root
MONGO_ROOT_SENHA=troque-esta-senha-root
# Usuário da aplicação (API e servidor de sessão): readWrite apenas no banco fast_attendance
MONGO_APP_USUARIO=fast_attendance
MONGO_APP_SENHA=troque-esta-senha-da-aplicacao

# Validade do JWT em horas
JWT_EXPIRACAO_HORAS=12

# Quem pode criar conta de professor, separado por vírgulas: e-mails completos ou domínios
# iniciados por @ (ex.: @puc-campinas.edu.br). O cadastro de alunos é aberto.
PROFESSORES_PERMITIDOS=professor@demo.br

# Porta publicada pelo Nginx no host
NGINX_PORTA=8088

# Sessões abertas há mais tempo que isto (em minutos) são encerradas automaticamente
SESSAO_DURACAO_MAXIMA_MIN=240
