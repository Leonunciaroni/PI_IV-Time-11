# Copie para infra/.env e ajuste os valores.

# Segredo HMAC usado para assinar e validar os JWTs (mínimo de 32 bytes).
# Gere um com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-pelo-menos-32-bytes

# Validade do JWT em horas
JWT_EXPIRACAO_HORAS=12

# Quem pode criar conta de professor, separado por vírgulas: e-mails completos ou domínios
# iniciados por @ (ex.: @puc-campinas.edu.br). O cadastro de alunos é aberto.
PROFESSORES_PERMITIDOS=professor@demo.br

# Porta publicada pelo Nginx no host
NGINX_PORTA=8088
